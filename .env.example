NEON_DATABASE_URL=postgresql://user:password@host/db?sslmode=require
NETLIFY_DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DANCES_SQL=select data as payload from line_dance_data limit 1
DANCES_SQL_WRITE=update line_dance_data set data = $1::jsonb

# Login utenti (tag personali)
# Stringa casuale di almeno 32 caratteri: openssl rand -base64 48
SESSION_SECRET=
# OAuth2 Google (Google Cloud Console > API e servizi > Credenziali)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth2 Facebook (developers.facebook.com) - opzionale
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Opzionale: forza l'origine pubblica usata per i redirect OAuth
# PUBLIC_BASE_URL=https://tuo-sito.netlify.app
# Amministratori: possono promuovere gli utenti a editor (email separate da virgola)
ADMIN_EMAILS=
